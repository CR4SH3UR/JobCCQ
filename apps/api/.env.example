# Copie ce fichier en `.env` (le code fournit déjà une valeur par défaut).
# Base de données SQLite locale (chemin relatif au dossier apps/api).
DATABASE_URL="file:./prisma/dev.db"

# Port et hôte de l'API
PORT=4000
HOST=0.0.0.0

# Admin Supabase (nécessaire pour lister les comptes dans /admin).
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_xxx"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxx"
ADMIN_EMAILS="ton@email.com"
SITE_URL="https://jobccqc.ca"
