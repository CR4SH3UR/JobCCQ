// Schéma de base de données JobCCQ.
// - Dev : fichier SQLite local (DATABASE_URL="file:./prisma/dev.db").
// - Prod : Turso (libSQL, compatible SQLite) via l'adaptateur de pilote —
//   défini TURSO_DATABASE_URL + TURSO_AUTH_TOKEN (voir src/db.ts et
//   infra/README-turso.md). Aucun changement de provider requis (libSQL = SQLite).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Prisma 7 : l'URL de connexion ne vit plus ici — elle est déclarée dans
  // prisma.config.ts (CLI) ; le client applicatif passe par l'adaptateur libSQL.
  provider = "sqlite"
}

/// Employeur du répertoire (auparavant packages/shared/src/discovered.json).
/// Éditable dans la console d'admin ; source des scrapers.
model Employer {
  id         String   @id
  name       String
  homepage   String
  careersUrl String
  method     String
  /// 2e page carrières (Jobillico, autre ATS) — scrapée sous le même id.
  careersUrl2 String?
  method2     String?
  region     String?
  rbq        String?
  scope      String?
  /// SQLite/libSQL n'a pas de type tableau : JSON sérialisé (comme Job.tags).
  sectors    String   @default("[]")
  verified   Boolean  @default(false)
  enabled    Boolean  @default(true)
  /// Note interne admin (pas affichée sur le site public).
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([enabled])
  @@index([verified])
}

/// Employeur volontairement retiré (supprimé ou fusionné). Empêche sync/import
/// de recréer la fiche depuis `discovered.json`.
model EmployerTombstone {
  id         String   @id
  /// deleted | merged
  reason     String
  mergedInto String?
  createdAt  DateTime @default(now())
}

/// Une offre d'emploi normalisée, provenant de n'importe quelle source.
model Job {
  id             String    @id
  sourceId       String
  url            String    @unique
  title          String
  company        String
  companyLogoUrl String?
  location       String?
  regionId       String?
  city           String?
  remote         String?
  categoryId     String?
  employmentType String?
  salaryMin      Float?
  salaryMax      Float?
  salaryPeriod   String?
  currency       String?   @default("CAD")
  description    String?
  // SQLite n'a pas de type tableau : on stocke du JSON sérialisé.
  tags           String    @default("[]")
  languages      String    @default("[]")
  postedAt       DateTime?
  scrapedAt      DateTime  @default(now())
  /// ok | gone | unknown — sonde HTTP du lien original (idée 18).
  linkStatus     String?
  /// Historique compact JSON (salaire / titre / réactivation).
  historyJson    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([company])
  @@index([regionId])
  @@index([categoryId])
  @@index([sourceId])
  @@index([postedAt])
  @@index([sourceId, url])
  @@index([regionId, postedAt])
  @@index([categoryId, postedAt])
  @@index([sourceId, scrapedAt])
  @@index([linkStatus])
  @@index([company, postedAt])
}

/// Journal d'une exécution de scraping (pour le suivi et le monitoring).
model ScrapeRun {
  id         Int       @id @default(autoincrement())
  sourceId   String
  status     String    @default("running") // running | success | error
  found      Int       @default(0)
  inserted   Int       @default(0)
  updated    Int       @default(0)
  /// Diff JSON { added, changed, removed } (titres + URLs), plafonné.
  diffJson     String?
  /// Offres retirées (JSON Job[]) pour un rollback du run.
  rollbackJson String?
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([sourceId])
}
