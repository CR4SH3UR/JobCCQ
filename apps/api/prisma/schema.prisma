// Schéma de base de données JobCCQ.
// - Dev : fichier SQLite local (DATABASE_URL="file:./prisma/dev.db").
// - Prod : Turso (libSQL, compatible SQLite) via l'adaptateur de pilote —
//   défini TURSO_DATABASE_URL + TURSO_AUTH_TOKEN (voir src/db.ts et
//   infra/README-turso.md). Aucun changement de provider requis (libSQL = SQLite).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Employeur du répertoire (auparavant packages/shared/src/discovered.json).
/// Éditable dans la console d'admin ; source des scrapers.
model Employer {
  id         String   @id
  name       String
  homepage   String
  careersUrl String
  method     String
  region     String?
  rbq        String?
  scope      String?
  /// SQLite/libSQL n'a pas de type tableau : JSON sérialisé (comme Job.tags).
  sectors    String   @default("[]")
  verified   Boolean  @default(false)
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([enabled])
  @@index([verified])
}

/// Une offre d'emploi normalisée, provenant de n'importe quelle source.
model Job {
  id             String    @id
  sourceId       String
  url            String    @unique
  title          String
  company        String
  companyLogoUrl String?
  location       String?
  regionId       String?
  city           String?
  remote         String?
  categoryId     String?
  employmentType String?
  salaryMin      Float?
  salaryMax      Float?
  salaryPeriod   String?
  currency       String?   @default("CAD")
  description    String?
  // SQLite n'a pas de type tableau : on stocke du JSON sérialisé.
  tags           String    @default("[]")
  languages      String    @default("[]")
  postedAt       DateTime?
  scrapedAt      DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([company])
  @@index([regionId])
  @@index([categoryId])
  @@index([sourceId])
  @@index([postedAt])
}

/// Journal d'une exécution de scraping (pour le suivi et le monitoring).
model ScrapeRun {
  id         Int       @id @default(autoincrement())
  sourceId   String
  status     String    @default("running") // running | success | error
  found      Int       @default(0)
  inserted   Int       @default(0)
  updated    Int       @default(0)
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([sourceId])
}
