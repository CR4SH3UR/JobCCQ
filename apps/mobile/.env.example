# URL de base de l'API JobCCQ (back-end Fastify).
# Par défaut, l'app utilise http://localhost:4000 si cette variable est absente.
#
# ⚠️ Sur un téléphone physique (Expo Go / build de dev), « localhost » désigne
# le téléphone lui-même, pas ta machine de dev : remplace-le par l'adresse IP
# LAN de la machine qui héberge l'API (ex. http://192.168.1.23:4000).
# Voir le README.md pour les détails.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Push Expo : mêmes clés anon que le site (table push_tokens).
# EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Sentry (idée 112) — vide = pas d'envoi.
# EXPO_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<projet>
