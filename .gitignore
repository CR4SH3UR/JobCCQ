# Instantané pour l'export statique : un instantané RÉEL est versionné
# (apps/web/public/data/jobs.json) afin que GitHub Pages serve de vraies offres.
# Régénérer après un scraping : npm run -w @jobccq/api export:static -- --from-db
#
# Instantané COMPLET (descriptions entières) : lu au build pour pré-générer les
# pages de détail. Volumineux et régénéré depuis Turso à chaque déploiement →
# non versionné (l'instantané client tronqué sert de repli hors Turso).
apps/web/data/jobs.full.json

